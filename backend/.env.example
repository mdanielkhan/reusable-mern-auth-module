# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# If your ISP/network blocks SRV DNS lookups (mongodb+srv://), use the
# non-SRV direct connection string from Atlas instead (Connect > Drivers >
# "Standard Connection String" fallback), e.g.:
# mongodb://user:pass@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/dbname?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/authdb

# ---- JWT ----
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email verification / reset tokens ----
EMAIL_VERIFICATION_EXPIRES_IN_MIN=60
PASSWORD_RESET_EXPIRES_IN_MIN=30

# ---- Nodemailer (SMTP) ----
# Any SMTP provider works. For dev, Mailtrap/Ethereal are easiest.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="No Reply <no-reply@example.com>"

# ---- Google OAuth ----
# Frontend uses Google Identity Services to get an ID token, backend verifies it.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- Cookies ----
# true in production (requires HTTPS). false for local http dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
